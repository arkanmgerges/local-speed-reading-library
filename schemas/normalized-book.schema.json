{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/arkanmgerges/local-speed-reading-library/schemas/normalized-book.schema.json",
  "title": "Normalized book",
  "description": "The canonical text of one edition as the app downloads it (gzip-compressed): plain Unicode paragraphs grouped in ordered chapters, plus provenance and rights. No markup, no styling, no tokenisation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workId", "editionId", "assetVersion", "language", "direction", "title", "author", "chapters", "provenance", "rights", "normalizer"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "editionId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+(-[a-z0-9]+)*$" },
    "assetVersion": { "type": "integer", "minimum": 1 },
    "language": { "type": "string", "minLength": 2 },
    "direction": { "enum": ["ltr", "rtl"] },
    "title": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "translator": { "type": ["string", "null"] },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "title", "paragraphs"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "title": { "type": ["string", "null"] },
          "paragraphs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "url", "identifier", "retrievedAt"],
      "properties": {
        "provider": { "type": "string" },
        "url": { "type": "string" },
        "identifier": { "type": "string" },
        "revision": { "type": ["string", "null"] },
        "pages": { "type": "array", "items": { "type": "object", "required": ["title", "revision"], "properties": { "title": { "type": "string" }, "revision": { "type": "integer" } } } },
        "retrievedAt": { "type": "string" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "statement"],
      "properties": {
        "status": { "enum": ["public-domain"] },
        "statement": { "type": "string" }
      }
    },
    "normalizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    }
  }
}
